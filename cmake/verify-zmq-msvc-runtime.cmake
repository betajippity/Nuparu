cmake_minimum_required(VERSION 3.20)
if(NOT EXISTS "${COMPILE_COMMANDS}")
    message(FATAL_ERROR "ZeroMQ's compile database is missing: ${COMPILE_COMMANDS}")
endif()
file(READ "${COMPILE_COMMANDS}" database)
string(JSON count LENGTH "${database}")
if(count EQUAL 0)
    message(FATAL_ERROR "ZeroMQ's compile database is empty")
endif()
math(EXPR last "${count} - 1")
set(checked_sources 0)
foreach(index RANGE ${last})
    string(JSON source GET "${database}" ${index} file)
    # The database can also contain Windows resource compiler commands, which
    # do not use an MSVC C/C++ runtime selection flag.
    string(TOLOWER "${source}" source_lower)
    if(NOT source_lower MATCHES "\\.(c|cc|cpp|cxx)$")
        continue()
    endif()
    math(EXPR checked_sources "${checked_sources} + 1")
    string(JSON command GET "${database}" ${index} command)
    if(command MATCHES "(^|[ \t\"])[/-]MDd?($|[ \t\"])" OR
       NOT command MATCHES "(^|[ \t\"])[/-]MT($|[ \t\"])")
        message(FATAL_ERROR "ZeroMQ must compile with /MT and without /MD: ${source}\n${command}")
    endif()
endforeach()
if(checked_sources EQUAL 0)
    message(FATAL_ERROR "ZeroMQ's compile database contains no C or C++ source files")
endif()
