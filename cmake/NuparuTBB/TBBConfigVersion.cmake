if(NOT EXISTS "${NUPARU_TBB_ROOT}/include/oneapi/tbb/version.h")
    set(PACKAGE_VERSION_UNSUITABLE TRUE)
    return()
endif()
foreach(part MAJOR MINOR PATCH)
    file(STRINGS "${NUPARU_TBB_ROOT}/include/oneapi/tbb/version.h" version_line
        REGEX "^#define TBB_VERSION_${part} +[0-9]+")
    string(REGEX REPLACE ".* +([0-9]+).*" "\\1" version_${part} "${version_line}")
endforeach()
set(PACKAGE_VERSION "${version_MAJOR}.${version_MINOR}.${version_PATCH}")
if(PACKAGE_VERSION VERSION_LESS PACKAGE_FIND_VERSION)
    set(PACKAGE_VERSION_COMPATIBLE FALSE)
else()
    set(PACKAGE_VERSION_COMPATIBLE TRUE)
    if(PACKAGE_VERSION VERSION_EQUAL PACKAGE_FIND_VERSION)
        set(PACKAGE_VERSION_EXACT TRUE)
    endif()
endif()
