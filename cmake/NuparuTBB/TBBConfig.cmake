# Adapter for Nuparu's existing TBB headers and dynamic library.
if(NOT NUPARU_TBB_ROOT)
    message(FATAL_ERROR "Set NUPARU_TBB_ROOT to the selected legacy Nuparu platform prefix")
endif()
set(_nuparu_tbb_library "${NUPARU_TBB_ROOT}/lib/${CMAKE_SHARED_LIBRARY_PREFIX}tbb${CMAKE_SHARED_LIBRARY_SUFFIX}")
if(NOT EXISTS "${_nuparu_tbb_library}" OR NOT EXISTS "${NUPARU_TBB_ROOT}/include/oneapi/tbb/version.h")
    message(FATAL_ERROR "Missing legacy Nuparu TBB library or headers under ${NUPARU_TBB_ROOT}")
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NuparuTBBExpected.cmake" OPTIONAL)
if(DEFINED NUPARU_EMBREE_TBB_VERSION)
    foreach(_part MAJOR MINOR PATCH)
        file(STRINGS "${NUPARU_TBB_ROOT}/include/oneapi/tbb/version.h" _line
            REGEX "^#define TBB_VERSION_${_part} +[0-9]+")
        string(REGEX REPLACE ".* +([0-9]+).*" "\\1" _version_${_part} "${_line}")
    endforeach()
    set(_nuparu_tbb_version "${_version_MAJOR}.${_version_MINOR}.${_version_PATCH}")
    if(NOT _nuparu_tbb_version VERSION_EQUAL NUPARU_EMBREE_TBB_VERSION)
        message(FATAL_ERROR "Embree was built with TBB ${NUPARU_EMBREE_TBB_VERSION}, but ${NUPARU_TBB_ROOT} has ${_nuparu_tbb_version}")
    endif()
endif()
if(TARGET TBB::tbb)
    get_target_property(_existing_tbb TBB::tbb IMPORTED_LOCATION)
    if(NOT _existing_tbb OR NOT EXISTS "${_existing_tbb}")
        message(FATAL_ERROR "An existing TBB::tbb target does not identify the selected legacy Nuparu library")
    endif()
    get_filename_component(_existing_tbb_real "${_existing_tbb}" REALPATH)
    get_filename_component(_nuparu_tbb_real "${_nuparu_tbb_library}" REALPATH)
    if(NOT _existing_tbb_real STREQUAL _nuparu_tbb_real)
        message(FATAL_ERROR "An existing TBB::tbb target uses '${_existing_tbb}', not '${_nuparu_tbb_library}'")
    endif()
else()
    add_library(TBB::tbb SHARED IMPORTED)
    set_target_properties(TBB::tbb PROPERTIES IMPORTED_LOCATION "${_nuparu_tbb_library}"
        INTERFACE_INCLUDE_DIRECTORIES "${NUPARU_TBB_ROOT}/include")
endif()
set(TBB_tbb_FOUND TRUE)
set(TBB_FOUND TRUE)
unset(_nuparu_tbb_library)
