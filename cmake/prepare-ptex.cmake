cmake_minimum_required(VERSION 3.20)
foreach(entry ZLIB_INCLUDE_DIR ZLIB_LIBRARY)
    file(STRINGS "${PTEX_CACHE}" line REGEX "^${entry}:[^=]*=")
    string(REGEX REPLACE "^[^=]*=" "" found "${line}")
    if(entry STREQUAL "ZLIB_INCLUDE_DIR")
        set(expected "${EXPECTED_ZLIB_INCLUDE}")
    else()
        set(expected "${EXPECTED_ZLIB_LIBRARY}")
    endif()
    cmake_path(NORMAL_PATH found)
    cmake_path(NORMAL_PATH expected)
    if(NOT found STREQUAL expected)
        message(FATAL_ERROR "Ptex selected ${entry} '${found}', expected '${expected}'")
    endif()
endforeach()
set(config "${PTEX_ROOT}/lib/cmake/Ptex/ptex-config.cmake")
file(READ "${config}" contents)
set(original "find_package(ZLIB REQUIRED)")
set(replacement "if(NOT TARGET ZLIB::ZLIB)\n  find_dependency(ZLIB REQUIRED)\nendif()")
string(FIND "${contents}" "${original}" original_position)
string(FIND "${contents}" "${replacement}" replacement_position)
if(NOT original_position EQUAL -1)
    string(REPLACE "${original}" "${replacement}" contents "${contents}")
    file(WRITE "${config}" "${contents}")
elseif(replacement_position EQUAL -1)
    message(FATAL_ERROR "Cannot adapt Ptex's zlib dependency; check the Ptex revision")
endif()
# Ptex 2.4.3's CMake files export only 2.4 and leave the pkg-config version
# empty; correct the generated metadata for the pinned release.
set(version_file "${PTEX_ROOT}/lib/cmake/Ptex/ptex-config-version.cmake")
file(READ "${version_file}" version_contents)
if(version_contents MATCHES "set\\(PACKAGE_VERSION \"2\\.4\"\\)")
    string(REPLACE "set(PACKAGE_VERSION \"2.4\")" "set(PACKAGE_VERSION \"2.4.3\")" version_contents "${version_contents}")
    file(WRITE "${version_file}" "${version_contents}")
elseif(NOT version_contents MATCHES "set\\(PACKAGE_VERSION \"2\\.4\\.3\"\\)")
    message(FATAL_ERROR "Unexpected Ptex package version metadata")
endif()
set(pc_file "${PTEX_ROOT}/share/pkgconfig/ptex.pc")
file(READ "${pc_file}" pc_contents)
string(REPLACE "\r\n" "\n" pc_contents "${pc_contents}")
if(pc_contents MATCHES "Version: *\n")
    string(REPLACE "Version: \n" "Version: 2.4.3\n" pc_contents "${pc_contents}")
elseif(NOT pc_contents MATCHES "Version: 2\\.4\\.3")
    message(FATAL_ERROR "Unexpected Ptex pkg-config version metadata")
endif()
string(REPLACE "Description: \n" "Description: Per-face texture mapping library\n" pc_contents "${pc_contents}")
if(NOT pc_contents MATCHES "Libs\\.private:")
    set(private_libs "-lz")
    if(PTEX_SYSTEM_NAME STREQUAL "Linux")
        string(APPEND private_libs " -pthread")
    endif()
    string(APPEND pc_contents "Libs.private: ${private_libs}\n")
endif()
file(WRITE "${pc_file}" "${pc_contents}")
