cmake_minimum_required(VERSION 3.20)
foreach(pair "ZLIB_INCLUDE_DIR|${STAGE_DIR}/zlib/include" "ZLIB_LIBRARY|${STAGE_DIR}/zlib/lib/${ZLIB_NAME}")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 name)
    list(GET fields 1 expected)
    file(STRINGS "${BLOSC_CACHE}" line REGEX "^${name}:[^=]*=")
    string(REGEX REPLACE "^[^=]*=" "" actual "${line}")
    file(REAL_PATH "${actual}" actual)
    file(REAL_PATH "${expected}" expected)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Blosc selected ${name}=${actual}, expected ${expected}")
    endif()
endforeach()
set(pc "${BLOSC_STAGE}/lib/pkgconfig/blosc.pc")
file(READ "${pc}" contents)
string(REPLACE "\r\n" "\n" contents "${contents}")
if(NOT contents MATCHES "Libs\\.private:")
    if(SYSTEM_NAME STREQUAL "Linux")
        string(APPEND contents "Libs.private: -lz -pthread\n")
    else()
        string(APPEND contents "Libs.private: -lz\n")
    endif()
    file(WRITE "${pc}" "${contents}")
endif()
