cmake_minimum_required(VERSION 3.20)
# Merge separately installed dependency stages without overwriting unrelated files.
set(manifest "${NUPARU_PACKAGE_DIR}/share/nuparu/files.txt")
set(previous_files)
if(EXISTS "${manifest}")
    file(STRINGS "${manifest}" previous_files)
endif()

set(package_files)
set(dependencies jsoncpp glfw zlib Imath openexr)
if(NUPARU_INCLUDE_PTEX)
    list(APPEND dependencies ptex)
endif()
if(NUPARU_INCLUDE_OPENSUBDIV)
    list(APPEND dependencies opensubdiv)
endif()
if(NUPARU_INCLUDE_BOOST)
    list(APPEND dependencies boost)
endif()
if(NUPARU_INCLUDE_TBB)
    list(APPEND dependencies tbb)
endif()
if(NUPARU_INCLUDE_EMBREE)
    list(APPEND dependencies embree)
endif()
foreach(dependency IN LISTS dependencies)
    set(stage "${NUPARU_STAGE_DIR}/${dependency}")
    file(GLOB_RECURSE stage_files LIST_DIRECTORIES FALSE RELATIVE "${stage}" "${stage}/*")
    if(NOT stage_files)
        message(FATAL_ERROR "Dependency stage is empty: ${stage}")
    endif()
    foreach(path IN LISTS stage_files)
        if(path IN_LIST package_files)
            message(FATAL_ERROR "Dependency package collision at ${path} (including ${dependency})")
        endif()
        if(path STREQUAL "share/nuparu/files.txt")
            message(FATAL_ERROR "A dependency attempted to overwrite Nuparu's manifest")
        endif()
        if((EXISTS "${NUPARU_PACKAGE_DIR}/${path}" OR IS_SYMLINK "${NUPARU_PACKAGE_DIR}/${path}")
           AND NOT path IN_LIST previous_files)
            message(FATAL_ERROR "Refusing to overwrite unmanaged file ${NUPARU_PACKAGE_DIR}/${path}; use an empty package prefix")
        endif()
        list(APPEND package_files "${path}")
        set("owner_${path}" "${dependency}")
    endforeach()
endforeach()

foreach(path IN LISTS previous_files)
    if(IS_ABSOLUTE "${path}" OR path MATCHES "(^|/)\\.\\.(/|$)" OR path STREQUAL "")
        message(FATAL_ERROR "Invalid path in package manifest: ${path}")
    endif()
    if(NOT path IN_LIST package_files)
        file(REMOVE "${NUPARU_PACKAGE_DIR}/${path}")
    endif()
endforeach()

foreach(path IN LISTS package_files)
    get_filename_component(directory "${NUPARU_PACKAGE_DIR}/${path}" DIRECTORY)
    file(MAKE_DIRECTORY "${directory}")
    set(stage "${NUPARU_STAGE_DIR}/${owner_${path}}")
    if(IS_SYMLINK "${stage}/${path}")
        file(READ_SYMLINK "${stage}/${path}" link_target)
        if(IS_ABSOLUTE "${link_target}" OR link_target MATCHES "(^|/)\\.\\.(/|$)")
            message(FATAL_ERROR "Invalid package symlink ${path}: ${link_target}")
        endif()
        file(REMOVE "${NUPARU_PACKAGE_DIR}/${path}")
        file(CREATE_LINK "${link_target}" "${NUPARU_PACKAGE_DIR}/${path}" SYMBOLIC RESULT link_result)
        if(NOT link_result STREQUAL "0")
            message(FATAL_ERROR "Cannot create package symlink ${path}: ${link_result}")
        endif()
    elseif(path MATCHES "^(lib|share)/pkgconfig/[^/]+\\.pc$")
        # Upstream files use the staging prefix; make the assembled package relocatable.
        file(READ "${stage}/${path}" pkgconfig)
        string(REPLACE "prefix=\"${stage}\"" "prefix=\"\${pcfiledir}/../..\"" pkgconfig "${pkgconfig}")
        string(REPLACE "prefix=${stage}" "prefix=\${pcfiledir}/../.." pkgconfig "${pkgconfig}")
        string(REPLACE "${stage}" "\${prefix}" pkgconfig "${pkgconfig}")
        file(WRITE "${NUPARU_PACKAGE_DIR}/${path}" "${pkgconfig}")
    else()
        configure_file("${stage}/${path}" "${NUPARU_PACKAGE_DIR}/${path}" COPYONLY)
    endif()
endforeach()
list(SORT package_files)
string(REPLACE ";" "\n" manifest_contents "${package_files}")
file(MAKE_DIRECTORY "${NUPARU_PACKAGE_DIR}/share/nuparu")
file(WRITE "${manifest}" "${manifest_contents}\n")
message(STATUS "Assembled Nuparu package: ${NUPARU_PACKAGE_DIR}")
