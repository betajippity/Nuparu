function(nuparu_embree_isa arch is_apple is_windows result)
    if(arch MATCHES "^(x86_64|AMD64)$")
        set(args -DEMBREE_ISA_SSE42:BOOL=ON -DEMBREE_ISA_AVX:BOOL=OFF
            -DEMBREE_ISA_AVX2:BOOL=OFF -DEMBREE_ISA_AVX512:BOOL=OFF)
        if(is_apple)
            list(APPEND args -DEMBREE_ISA_SSE2:BOOL=OFF)
        else()
            list(APPEND args -DEMBREE_ISA_SSE2:BOOL=ON)
        endif()
    elseif(arch MATCHES "^(aarch64|arm64|ARM64)$")
        if(is_windows)
            set(args -DEMBREE_ISA_NEON:BOOL=ON -DEMBREE_ISA_NEON2X:BOOL=OFF)
        else()
            set(args -DEMBREE_ISA_NEON:BOOL=OFF -DEMBREE_ISA_NEON2X:BOOL=ON)
        endif()
    else()
        message(FATAL_ERROR "Unsupported Embree pilot architecture: ${arch}")
    endif()
    set(${result} "${args}" PARENT_SCOPE)
endfunction()
