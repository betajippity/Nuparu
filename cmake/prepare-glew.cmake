cmake_minimum_required(VERSION 3.20)
set(targets "${GLEW_STAGE}/lib/cmake/glew/glew-targets.cmake")
file(READ "${targets}" contents)
if(NOT contents MATCHES "INTERFACE_LINK_LIBRARIES \"[^\"]*\"")
    message(FATAL_ERROR "Cannot find GLEW's exported link dependencies")
endif()
if(SYSTEM_NAME STREQUAL "Linux")
    set(replacement "INTERFACE_LINK_LIBRARIES \"OpenGL::GL;X11::X11\"")
else()
    set(replacement "INTERFACE_LINK_LIBRARIES \"OpenGL::GL\"")
endif()
string(REGEX REPLACE "INTERFACE_LINK_LIBRARIES \"[^\"]*\"" "${replacement}" contents "${contents}")
file(WRITE "${targets}" "${contents}")
set(config "${GLEW_STAGE}/lib/cmake/glew/glew-config.cmake")
file(READ "${config}" contents)
set(marker "# Nuparu relocatable system dependencies")
string(FIND "${contents}" "${marker}" position)
if(position EQUAL -1)
    set(prefix "${marker}\ninclude(CMakeFindDependencyMacro)\nfind_dependency(OpenGL)\n")
    if(SYSTEM_NAME STREQUAL "Linux")
        string(APPEND prefix "find_dependency(X11)\n")
    endif()
    file(WRITE "${config}" "${prefix}${contents}")
endif()
