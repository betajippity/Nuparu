cmake_minimum_required(VERSION 3.20)
foreach(entry TBB_DIR PTEX_INCLUDE_DIR PTEX_LIBRARY)
    file(STRINGS "${OSD_CACHE}" line REGEX "^${entry}:[^=]*=")
    string(REGEX REPLACE "^[^=]*=" "" found "${line}")
    if(entry STREQUAL "TBB_DIR")
        set(expected "${EXPECTED_TBB_DIR}")
    elseif(entry STREQUAL "PTEX_INCLUDE_DIR")
        set(expected "${EXPECTED_PTEX_DIR}")
    else()
        set(expected "${EXPECTED_PTEX_LIBRARY}")
    endif()
    cmake_path(NORMAL_PATH found)
    cmake_path(NORMAL_PATH expected)
    if(NOT found STREQUAL expected)
        message(FATAL_ERROR "OpenSubdiv selected ${entry} '${found}', expected '${expected}'")
    endif()
endforeach()
set(required_headers tbbEvaluator.h)
if(EXPECT_OPENGL)
    list(APPEND required_headers glVertexBuffer.h)
endif()
if(EXPECT_CUDA)
    list(APPEND required_headers cudaEvaluator.h)
endif()
if(EXPECT_METAL)
    list(APPEND required_headers mtlComputeEvaluator.h)
endif()
foreach(header IN LISTS required_headers)
    if(NOT EXISTS "${OSD_ROOT}/include/opensubdiv/osd/${header}")
        message(FATAL_ERROR "OpenSubdiv did not build the requested backend (missing ${header}). Check the SDK and build log; use a fresh build directory after changing backend options.")
    endif()
endforeach()
set(required_definitions OPENSUBDIV_HAS_TBB OPENSUBDIV_HAS_PTEX)
if(EXPECT_OPENGL)
    list(APPEND required_definitions OPENSUBDIV_HAS_OPENGL)
endif()
if(EXPECT_CUDA)
    list(APPEND required_definitions OPENSUBDIV_HAS_CUDA)
endif()
if(EXPECT_METAL)
    list(APPEND required_definitions OPENSUBDIV_HAS_METAL)
endif()
file(READ "${OSD_ROOT}/lib/cmake/OpenSubdiv/OpenSubdivTargets.cmake" exports)
foreach(backend OPENGL CUDA METAL)
    if(NOT EXPECT_${backend} AND exports MATCHES "OPENSUBDIV_HAS_${backend}")
        message(FATAL_ERROR "OpenSubdiv unexpectedly exported the ${backend} backend; use a fresh build directory after changing backend options")
    endif()
endforeach()
if((EXPECT_OPENGL OR EXPECT_CUDA OR EXPECT_METAL) AND NOT exports MATCHES "OpenSubdiv::osdGPU_static")
    message(FATAL_ERROR "OpenSubdiv did not export the requested static GPU library")
endif()
foreach(definition IN LISTS required_definitions)
    string(FIND "${exports}" "${definition}" position)
    if(position EQUAL -1)
        message(FATAL_ERROR "OpenSubdiv did not export ${definition}; check dependency discovery and the build log")
    endif()
endforeach()
# Upstream's exported static CPU target references TBB::tbb, but its package
# config does not locate that target for downstream consumers.
set(config "${OSD_ROOT}/lib/cmake/OpenSubdiv/OpenSubdivConfig.cmake")
file(READ "${config}" contents)
set(original "include(\"\${CMAKE_CURRENT_LIST_DIR}/OpenSubdivTargets.cmake\")")
set(replacement "include(CMakeFindDependencyMacro)\nfind_dependency(TBB 2022.1.0 EXACT CONFIG COMPONENTS tbb)\n${original}")
string(FIND "${contents}" "${replacement}" replacement_position)
if(replacement_position EQUAL -1)
    string(FIND "${contents}" "${original}" original_position)
    if(original_position EQUAL -1)
        message(FATAL_ERROR "Cannot adapt OpenSubdiv's TBB dependency; check the upstream revision")
    endif()
    string(REPLACE "${original}" "${replacement}" contents "${contents}")
    file(WRITE "${config}" "${contents}")
endif()
