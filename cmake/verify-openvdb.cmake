cmake_minimum_required(VERSION 3.20)
foreach(pair "Tbb_INCLUDE_DIR|tbb" "Tbb_tbb_LIBRARY_RELEASE|tbb"
             "Blosc_INCLUDE_DIR|blosc" "Blosc_LIBRARY_RELEASE|blosc"
             "Boost_DIR|boost" "Imath_DIR|Imath" "ZLIB_INCLUDE_DIR|zlib")
    string(REPLACE "|" ";" fields "${pair}")
    list(GET fields 0 name)
    list(GET fields 1 dependency)
    file(STRINGS "${VDB_CACHE}" line REGEX "^${name}:[^=]*=")
    string(REGEX REPLACE "^[^=]*=" "" actual "${line}")
    if(NOT EXISTS "${actual}")
        message(FATAL_ERROR "OpenVDB did not locate ${name}: ${actual}")
    endif()
    file(REAL_PATH "${actual}" actual)
    file(REAL_PATH "${STAGE_DIR}/${dependency}" expected)
    cmake_path(IS_PREFIX expected "${actual}" NORMALIZE within_stage)
    if(NOT within_stage)
        message(FATAL_ERROR "OpenVDB selected ${name}=${actual}, outside ${expected}")
    endif()
endforeach()
