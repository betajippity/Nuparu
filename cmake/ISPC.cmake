# ISPC is a host build tool, not part of the assembled Nuparu package.
function(nuparu_ispc_release host_os host_arch archive_var hash_var)
    if(host_os STREQUAL "Darwin" AND host_arch MATCHES "^(arm64|aarch64|x86_64|AMD64)$")
        set(archive "ispc-v1.32.0-macOS.universal.tar.gz")
        set(hash "9b7bf6cc9fbd8085be267a1d2179fc926e899abf3ded56cd685b4a52f9ee7e98")
    elseif(host_os STREQUAL "Linux" AND host_arch MATCHES "^(x86_64|AMD64)$")
        set(archive "ispc-v1.32.0-linux.tar.gz")
        set(hash "faf266bda2b702d68976ffd26bbd36c1ddba43424cc3c44f25b092cd1aa1f64a")
    elseif(host_os STREQUAL "Linux" AND host_arch MATCHES "^(aarch64|arm64)$")
        set(archive "ispc-v1.32.0-linux.aarch64.tar.gz")
        set(hash "ddb892a25ffb2f212a63c59540262556e50cc72b1b0c89bed7735d66da69626d")
    elseif(host_os STREQUAL "Windows" AND host_arch MATCHES "^(x86_64|AMD64|amd64|ARM64|arm64|aarch64)$")
        # The x86-64 release also runs under Windows ARM64 emulation.
        set(archive "ispc-v1.32.0-windows.zip")
        set(hash "148d5cd96abe7501c730d5fbd00f1f0c893b96bfeada38d1811c9b6251e86a5c")
    else()
        message(FATAL_ERROR "No automatic ISPC 1.32.0 package for host ${host_os}/${host_arch}; set NUPARU_ISPC_EXECUTABLE")
    endif()
    set(${archive_var} "${archive}" PARENT_SCOPE)
    set(${hash_var} "${hash}" PARENT_SCOPE)
endfunction()

function(nuparu_resolve_ispc result)
    nuparu_ispc_release("${CMAKE_HOST_SYSTEM_NAME}" "${CMAKE_HOST_SYSTEM_PROCESSOR}" archive_name expected_hash)
    file(MAKE_DIRECTORY "${NUPARU_ISPC_CACHE_DIR}")
    file(LOCK "${NUPARU_ISPC_CACHE_DIR}/.lock" GUARD FUNCTION TIMEOUT 300 RESULT_VARIABLE lock_result)
    if(NOT lock_result STREQUAL "0")
        message(FATAL_ERROR "Cannot lock ISPC cache ${NUPARU_ISPC_CACHE_DIR}: ${lock_result}")
    endif()
    string(REGEX REPLACE "(\\.tar\\.gz|\\.zip)$" "" release_dir "${archive_name}")
    if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Windows")
        set(ispc_name ispc.exe)
    else()
        set(ispc_name ispc)
    endif()
    set(executable "${NUPARU_ISPC_CACHE_DIR}/${release_dir}/bin/${ispc_name}")
    set(marker "${NUPARU_ISPC_CACHE_DIR}/${release_dir}.sha256")
    if(NUPARU_ISPC_ARCHIVE)
        if(NOT EXISTS "${NUPARU_ISPC_ARCHIVE}")
            message(FATAL_ERROR "ISPC archive does not exist: ${NUPARU_ISPC_ARCHIVE}")
        endif()
        file(SHA256 "${NUPARU_ISPC_ARCHIVE}" supplied_hash)
        if(NOT supplied_hash STREQUAL expected_hash)
            message(FATAL_ERROR "ISPC archive SHA-256 mismatch for ${NUPARU_ISPC_ARCHIVE}: expected ${expected_hash}, got ${supplied_hash}")
        endif()
    endif()
    if(EXISTS "${executable}" AND EXISTS "${marker}")
        file(READ "${marker}" marker_hash)
        string(STRIP "${marker_hash}" marker_hash)
        if(marker_hash STREQUAL expected_hash)
            set(${result} "${executable}" PARENT_SCOPE)
            return()
        endif()
    endif()

    if(NUPARU_ISPC_ARCHIVE)
        set(archive "${NUPARU_ISPC_ARCHIVE}")
    else()
        set(archive "${NUPARU_ISPC_CACHE_DIR}/${archive_name}")
        set(cached_hash "")
        if(EXISTS "${archive}")
            file(SHA256 "${archive}" cached_hash)
        endif()
        if(NOT cached_hash STREQUAL expected_hash)
            if(NOT NUPARU_ISPC_AUTO_DOWNLOAD)
                message(FATAL_ERROR "ISPC archive is not cached; set NUPARU_ISPC_ARCHIVE or NUPARU_ISPC_EXECUTABLE, or enable NUPARU_ISPC_AUTO_DOWNLOAD")
            endif()
            set(url "https://github.com/ispc/ispc/releases/download/v1.32.0/${archive_name}")
            message(STATUS "Downloading ISPC 1.32.0 for ${CMAKE_HOST_SYSTEM_NAME}/${CMAKE_HOST_SYSTEM_PROCESSOR}: ${url}")
            file(DOWNLOAD "${url}" "${archive}.partial" TLS_VERIFY ON STATUS download_status SHOW_PROGRESS)
            list(GET download_status 0 download_code)
            list(GET download_status 1 download_message)
            if(NOT download_code EQUAL 0)
                file(REMOVE "${archive}.partial")
                message(FATAL_ERROR "ISPC download failed: ${download_message}. Set NUPARU_ISPC_ARCHIVE or NUPARU_ISPC_EXECUTABLE to use a local copy.")
            endif()
            file(SHA256 "${archive}.partial" downloaded_hash)
            if(NOT downloaded_hash STREQUAL expected_hash)
                file(REMOVE "${archive}.partial")
                message(FATAL_ERROR "ISPC download SHA-256 mismatch for ${url}: expected ${expected_hash}, got ${downloaded_hash}")
            endif()
            file(RENAME "${archive}.partial" "${archive}")
        endif()
    endif()
    file(SHA256 "${archive}" actual_hash)
    if(NOT actual_hash STREQUAL expected_hash)
        message(FATAL_ERROR "ISPC archive SHA-256 mismatch for ${archive}: expected ${expected_hash}, got ${actual_hash}")
    endif()
    message(STATUS "Extracting verified ISPC 1.32.0 archive: ${archive}")
    file(ARCHIVE_EXTRACT INPUT "${archive}" DESTINATION "${NUPARU_ISPC_CACHE_DIR}")
    if(NOT EXISTS "${executable}")
        message(FATAL_ERROR "ISPC executable missing from verified archive: ${executable}")
    endif()
    file(WRITE "${marker}" "${expected_hash}\n")
    set(${result} "${executable}" PARENT_SCOPE)
endfunction()
