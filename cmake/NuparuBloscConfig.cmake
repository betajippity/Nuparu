get_filename_component(_nuparu_blosc_prefix "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
include(CMakeFindDependencyMacro)
find_dependency(Threads)
if(WIN32)
    set(_nuparu_blosc_archive "${_nuparu_blosc_prefix}/lib/libblosc.lib")
    set(_nuparu_zlib_archive "${_nuparu_blosc_prefix}/lib/z.lib")
else()
    set(_nuparu_blosc_archive "${_nuparu_blosc_prefix}/lib/libblosc.a")
    set(_nuparu_zlib_archive "${_nuparu_blosc_prefix}/lib/libz.a")
endif()
if(NOT EXISTS "${_nuparu_blosc_archive}" OR NOT EXISTS "${_nuparu_zlib_archive}" OR
   NOT EXISTS "${_nuparu_blosc_prefix}/include/blosc.h")
    message(FATAL_ERROR "Nuparu Blosc package is incomplete: ${_nuparu_blosc_prefix}")
endif()
if(NOT TARGET ZLIB::ZLIB)
    add_library(ZLIB::ZLIB STATIC IMPORTED GLOBAL)
    set_target_properties(ZLIB::ZLIB PROPERTIES IMPORTED_LOCATION "${_nuparu_zlib_archive}"
        INTERFACE_INCLUDE_DIRECTORIES "${_nuparu_blosc_prefix}/include")
else()
    get_target_property(_nuparu_existing_zlib ZLIB::ZLIB IMPORTED_LOCATION)
    if(NOT _nuparu_existing_zlib)
        get_target_property(_nuparu_existing_zlib ZLIB::ZLIB IMPORTED_LOCATION_RELEASE)
    endif()
    get_filename_component(_nuparu_existing_zlib "${_nuparu_existing_zlib}" REALPATH)
    get_filename_component(_nuparu_expected_zlib "${_nuparu_zlib_archive}" REALPATH)
    if(NOT _nuparu_existing_zlib STREQUAL _nuparu_expected_zlib)
        message(FATAL_ERROR "Existing ZLIB::ZLIB is not from the selected Nuparu package")
    endif()
endif()
if(NOT TARGET Nuparu::blosc)
    add_library(Nuparu::blosc STATIC IMPORTED GLOBAL)
    set_target_properties(Nuparu::blosc PROPERTIES IMPORTED_LOCATION "${_nuparu_blosc_archive}"
        INTERFACE_INCLUDE_DIRECTORIES "${_nuparu_blosc_prefix}/include"
        INTERFACE_LINK_LIBRARIES "ZLIB::ZLIB;Threads::Threads")
endif()
